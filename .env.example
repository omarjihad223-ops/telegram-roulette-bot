# ============================================
# Telegram Roulette Bot — Environment Variables
# Copy this file to `.env` and fill in real values.
# NEVER commit the real `.env` file to Git.
# ============================================

# Get this from @BotFather on Telegram after creating your bot.
BOT_TOKEN=

# Your bot's username WITHOUT the @, e.g. MyAwesomeBot
# Used to build each prize's own invite link (t.me/MyAwesomeBot?start=task_xxxxx).
BOT_USERNAME=
# Optional — Mini App short name from @BotFather (e.g. "app"). When set, referral links
# open straight into the Mini App (t.me/BOT_USERNAME/SHORT_NAME?startapp=...) instead of
# the bot's chat. Leave empty to keep the current behavior.
MINI_APP_SHORT_NAME=

# MongoDB connection string. For local dev: mongodb://localhost:27017/roulette_bot
# For MongoDB Atlas (recommended for Replit): mongodb+srv://user:pass@cluster.mongodb.net/roulette_bot
MONGODB_URI=

# Your personal Telegram numeric ID. This account becomes the permanent Owner —
# no developer can remove or downgrade this account. Get your ID from @userinfobot.
OWNER_ID=

# The public HTTPS URL where your Mini App is served (usually your Replit app URL,
# or the URL you set in @BotFather via /newapp). Must be HTTPS.
MINI_APP_URL=

# Telegram @username (without @) support messages should be directed to.
SUPPORT_USERNAME=O1916

# Telegram @username (without @) the user is told to DM once their withdrawal is approved,
# to actually receive their account/prize.
DELIVERY_CONTACT_USERNAME=kk66kk6

# Telegram @username (without @) of the group the user is told to mention the delivery
# contact in, if that contact takes too long to respond after approval.
ESCALATION_GROUP_USERNAME=CHJROB

# A long, random, secret string — used to sign/validate internal requests.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Do NOT use your Replit URL or anything guessable here.
WEBAPP_SECRET=

NODE_ENV=production
PORT=3000
