{
  "name": "roulette-bot-server",
  "version": "1.0.0",
  "private": true,
  "type": "commonjs",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "seed": "tsx src/workers/seed.ts",
    "sync-prize-names": "tsx src/scripts/syncPrizeNames.ts",
    "fix-duplicate-prizes": "tsx src/scripts/fixDuplicatePrizes.ts"
  },
  "dependencies": {
    "express": "^4.19.2",
    "mongoose": "^8.5.0",
    "node-telegram-bot-api": "^0.66.0",
    "dotenv": "^16.4.5",
    "zod": "^3.23.8",
    "pino": "^9.3.1",
    "pino-http": "^10.2.0",
    "pino-pretty": "^11.2.1",
    "node-cron": "^3.0.3",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "express-rate-limit": "^7.3.1",
    "nanoid": "^3.3.7",
    "multer": "^1.4.5-lts.1"
  },
  "devDependencies": {
    "typescript": "^5.5.4",
    "tsx": "^4.16.2",
    "vitest": "^2.0.5",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.14",
    "@types/cors": "^2.8.17",
    "@types/node-telegram-bot-api": "^0.64.7",
    "@types/multer": "^1.4.11"
  }
}
